# ============================================================
#  sdkconfig.defaults - esp32s3o-finware (ESP32-S3 N16R8)
#  Target: ESP-IDF v6.0.3
#  CPU 240MHz, flash Quad 16MB @80MHz, PSRAM Octal 8MB @80MHz
#  (el flash Boya de este modulo NO soporta HPM 120MHz)
#  Pensado para 3x nRF24L01+:
#    SPI2 -> NRF1 (CE4/CS10) + NRF2 (CE5/CS9)
#    SPI3 -> NRF3 (CE1/CS21)
#  Core0 = NRF2 solo | Core1 = NRF1 + NRF3 (buses distintos)
# ============================================================

# ---- CPU a tope: 240MHz, dual-core ----
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Flash: Quad 16MB a 80MHz ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---- PSRAM: Octal 8MB a 80MHz ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ---- Cache de instrucciones/datos al maximo ----
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- Compilador a maximo rendimiento ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- SPI y GPIO en IRAM ----
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_GPIO_ISR_IRAM_SAFE=y
CONFIG_ESP_INTR_IN_IRAM=y
# ---- Watchdog ----
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---- Consola ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
