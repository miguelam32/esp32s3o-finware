# =============================================================================
# esp32s3o-finware | ESP-IDF v6.0.1 | sdkconfig.defaults (modo velocidad)
# ESP32-S3 N16R8: flash QIO 16MB + PSRAM embebida 8MB (NO octal externa).
# Cambios aqui: rm sdkconfig && idf.py set-target esp32s3
# =============================================================================

# ---- Target / flash ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- Tabla de particiones: nuestra partitions.csv ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- CPU / FreeRTOS ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_RINGBUF_IN_IRAM=y
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=n

# ---- Compilador ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- Caches (cuestan ~48 KB de RAM interna) ----
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_8WAYS=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- PSRAM: DESACTIVADA ----
# Tu chip es QFN56 con PSRAM embebida (8MB), pero el bootloader se cuelga
# (TG0WDT_SYS_RST) al intentar inicializarla en modo octal. Hasta resolver
# eso, el ring de captura vive en RAM interna (ver rf_core.c, 64 slots).
CONFIG_SPIRAM=n
# CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_USE_MALLOC=y
# CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# CONFIG_SPIRAM_MEMTEST=n

# ---- SPI (nRF24) y GPIO en IRAM: latencia minima ----
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# ---- Wi-Fi ----
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# ---- Sin power management ----
CONFIG_PM_ENABLE=n

# ---- Watchdog ----
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---- Logs ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3
