# =============================================================================
#  sdkconfig.defaults.120mhz · ESP32-S3 N16R8 · ESP-IDF 6.0.3
#  PRUEBA: PSRAM a 120 MHz DDR (experimental). Mismo archivo base, solo
#  cambia el bloque de PSRAM. Si el chip no bootea o se calienta y falla,
#  vuelve al sdkconfig.defaults original (80 MHz).
# =============================================================================

CONFIG_IDF_TARGET="esp32s3"

# --- CPU y RTOS --------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_IN_IRAM=y

# --- SPI para los 2 NRF24L01 --------------------------------------------------
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# --- Compilador --------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Flash: 16 MB, QUAD --------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM: OCTAL 8 MB a 120 MHz (EXPERIMENTAL) --------------------------------
# CAMBIO respecto al original: SPEED_80M -> SPEED_120M.
# Tu chip es rev v0.2 + PSRAM AP_3v3, que es la combinación candidata para
# este modo, pero el flash (Boya quad) no está confirmado como compatible
# con la combinación exacta que exige 120 MHz. Si el bootloader no arranca
# o se cuelga justo después del log de flash, es que tu combo no califica.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# CONFIG_SPIRAM_MEMTEST is not set

# --- Caches ----------------------------------------------------------------------
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# --- XIP desde PSRAM -------------------------------------------------------------
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# --- Wi-Fi: modo TX-only a tope ----------------------------------------------------
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20

# --- lwIP --------------------------------------------------------------------------
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# --- Particiones -----------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Logs al minimo -----------------------------------------------------------------
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
